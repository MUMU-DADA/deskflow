[Unit]
Description=Deskflow foreground-game state bridge for KWin
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.deskflow.ForegroundGame
ExecStart=/usr/bin/python3 %h/.local/libexec/deskflow-foreground-writer.py
Restart=on-failure

[Install]
WantedBy=graphical-session.target
